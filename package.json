{
	"name": "@primitivestack/core",
	"version": "1.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun --bun tsdown",
		"dev": "bun --bun tsdown --watch",
		"test": "bun test && bun run test:types",
		"test:types": "tstyche"
	},
	"dependencies": {
		"ramda": "^0.31.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"@primitivestack/config": "0.0.2",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/bun": "^1.4.4",
		"@types/ramda": "^0.30.2",
		"conventional-changelog-conventionalcommits": "^8.0.0",
		"semantic-release": "^25.0.9",
		"tsdown": "latest",
		"tstyche": "^7.2.5",
		"type-fest": "^4.41.0",
		"typescript": "5.8.3"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
